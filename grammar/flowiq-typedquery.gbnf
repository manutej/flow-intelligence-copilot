# FlowIQ TypedQuery | Clarify | DraftRequest -- llama.cpp GBNF
# Source: /workspace/ormus/fic-fixes @ feat/three-layer-frame (HEAD 58a8488, after aa6eb2c)
#   ParsedQueryIntent / IntentDomain / IntentMeasure / IntentAggregation : src/agent/intent.ts
#   TypedQuery {question, intent, result_schema?}                       : src/data/schema.ts
#   UnitStatus / LeaseType / RenewalStatus / DecisionDirection          : src/data/schema.ts
#   DATE_WINDOWS keys                                                   : src/config/rules.ts
#   view / source / class / decision_id values                          : data/*.csv (store-derived)
# Exactly one JSON object, compact, fixed key order. No protected-class fields,
# no person entities, no route / slow-by-person operations.

root ::= typed-query | clarify | draft

# ---------- TypedQuery ----------
typed-query ::= "{\"kind\":\"query\",\"question\":" string ",\"intent\":" intent ( ",\"result_schema\":" result-schema )? "}"

intent ::= ( "{\"domain\":" domain ",\"measure\":" measure ",\"aggregation\":" aggregation
  ",\"isWholePortfolioExplicit\":" bool ",\"isClassComparison\":" bool
  ",\"dateWindow\":" date-window ",\"dateExplicit\":" bool
  ",\"mentionedSources\":" sources ",\"paidOnly\":" bool ",\"decisionIds\":" decision-ids
  opt-topk opt-class opt-ybmin opt-ybmax opt-beds opt-baths opt-rentmin opt-rentmax
  opt-bedsmin opt-bedsmax opt-bathsmin opt-bathsmax opt-sqftmin opt-sqftmax
  opt-floormin opt-floormax opt-view opt-ustatus opt-ustatusin opt-ltype opt-rstatus
  opt-lsw opt-lew opt-daccepted opt-ddir "}" )

opt-topk     ::= ( ",\"topK\":" topk )?
opt-class    ::= ( ",\"buildingClass\":" building-class )?
opt-ybmin    ::= ( ",\"yearBuiltMin\":" year )?
opt-ybmax    ::= ( ",\"yearBuiltMax\":" year )?
opt-beds     ::= ( ",\"bedrooms\":" count )?
opt-baths    ::= ( ",\"bathrooms\":" half-num )?
opt-rentmin  ::= ( ",\"rentMin\":" usd )?
opt-rentmax  ::= ( ",\"rentMax\":" usd )?
opt-bedsmin  ::= ( ",\"bedroomsMin\":" count )?
opt-bedsmax  ::= ( ",\"bedroomsMax\":" count )?
opt-bathsmin ::= ( ",\"bathroomsMin\":" half-num )?
opt-bathsmax ::= ( ",\"bathroomsMax\":" half-num )?
opt-sqftmin  ::= ( ",\"sqftMin\":" uint )?
opt-sqftmax  ::= ( ",\"sqftMax\":" uint )?
opt-floormin ::= ( ",\"floorMin\":" uint )?
opt-floormax ::= ( ",\"floorMax\":" uint )?
opt-view     ::= ( ",\"view\":" view )?
opt-ustatus  ::= ( ",\"unitStatus\":" unit-status )?
opt-ustatusin ::= ( ",\"unitStatusIn\":[" unit-status "," unit-status "]" )?
opt-ltype    ::= ( ",\"leaseType\":" lease-type )?
opt-rstatus  ::= ( ",\"renewalStatus\":" renewal-status )?
opt-lsw      ::= ( ",\"leaseStartWindow\":" date-window )?
opt-lew      ::= ( ",\"leaseEndWindow\":" date-window )?
opt-daccepted ::= ( ",\"decisionAccepted\":" ( "\"yes\"" | "\"no\"" | "\"all\"" ) )?
opt-ddir     ::= ( ",\"decisionDirection\":" ( "\"increase\"" | "\"decrease\"" ) )?

domain ::= "\"data_quality\"" | "\"decisions\"" | "\"marketing\"" | "\"leases\"" | "\"units\""

# IntentMeasure minus 'unsupported' (the model emits Clarify/Draft instead).
measure ::= ( "\"void_and_duplicate_counts\"" | "\"decision_lookup\"" | "\"decision_cohort_rejected\""
  | "\"decision_post_spend_comparison\"" | "\"decision_outcome_learning\"" | "\"reallocation_leases\""
  | "\"dead_spend_pairs\"" | "\"dead_spend_building\"" | "\"tour_to_lease_rate\"" | "\"apply_rate\""
  | "\"applied_without_tour\"" | "\"applied_and_leased\"" | "\"cost_per_lead_and_tour\""
  | "\"cost_per_lead\"" | "\"cost_per_tour\"" | "\"lead_count\"" | "\"leads_leased\"" | "\"spend_h1_vs_q3\""
  | "\"spend_total\"" | "\"signed_leases_ranking\"" | "\"cost_per_signed_lease\""
  | "\"ending_and_renewed\"" | "\"renewal_rate\"" | "\"renewal_rate_class_comparison\""
  | "\"new_vs_renewal_and_concession\"" | "\"average_concession\"" | "\"total_concession\"" | "\"rent_at_risk\""
  | "\"lease_count\"" | "\"vacancy_rate\"" | "\"occupied_share\"" | "\"avg_market_rent_and_sqft\""
  | "\"avg_market_rent\"" | "\"avg_sqft\"" | "\"rent_per_sqft\"" | "\"unit_count\"" )

aggregation ::= "\"value\"" | "\"argmax\"" | "\"argmin\"" | "\"list\"" | "\"compare\""

unit-status    ::= "\"occupied\"" | "\"notice\"" | "\"vacant\""
lease-type     ::= "\"new\"" | "\"renewal\""
renewal-status ::= "\"renewed\"" | "\"pending\"" | "\"notice_given\"" | "\"not_due\""
building-class ::= "\"A\"" | "\"B\""
view           ::= "\"city\"" | "\"courtyard\"" | "\"lake\"" | "\"none\""
source ::= ( "\"Apartment List\"" | "\"Apartments.com\"" | "\"Facebook Ads\"" | "\"Google Ads\""
  | "\"Referral\"" | "\"Rent.\"" | "\"Website\"" | "\"Zillow\"" )
sources ::= "[]" | "[" source ( "," source )* "]"
decision-id ::= "\"X0" [0-9] [0-9] "\""
decision-ids ::= "[]" | "[" decision-id ( "," decision-id )* "]"

# DateWindowSpec is emitted by key only; code resolves label/dates/months.
# Static keys from DATE_WINDOWS plus the dynamic MON_YYYY / YEAR_YYYY keys
# that parseExplicitDateWindow builds.
date-window ::= "\"" ( "H1_2026" | "Q2_2026" | "Q3_2026" | "Q4_2026" | "APR_SEP_2026" | "YEAR_2026"
  | "Q1_2027" | mon "_20" [0-9] [0-9] | "YEAR_20" [0-9] [0-9] ) "\""
mon ::= "JAN" | "FEB" | "MAR" | "APR" | "MAY" | "JUN" | "JUL" | "AUG" | "SEP" | "OCT" | "NOV" | "DEC"

# result_schema: Record<string,string>, keys snake_case, values a type word.
result-schema ::= "{}" | "{" rs-pair ( "," rs-pair )* "}"
rs-pair ::= "\"" [a-z] [a-z0-9_]{0,40} "\":" rs-type
rs-type ::= "\"string\"" | "\"number\"" | "\"integer\"" | "\"boolean\"" | "\"array\"" | "\"object\"" | "\"usd\"" | "\"percent\""

# ---------- Clarify ----------
clarify ::= "{\"kind\":\"clarify\",\"options\":[" string "," string ( "," string )? ( "," string )? "]}"

# ---------- DraftRequest (no writer in the repo: minimal) ----------
draft ::= "{\"kind\":\"draft\",\"request\":" string "}"

# ---------- terminals ----------
bool  ::= "true" | "false"
topk  ::= [2-9] | "10"
count ::= [0-9]
half-num ::= [0-9] ( ".5" )?
year  ::= ( "19" | "20" ) [0-9] [0-9]
uint  ::= "0" | [1-9] [0-9]{0,5}
usd   ::= uint ( "." [0-9] [0-9]? )?
string ::= "\"" char{1,300} "\""
char  ::= [^"\\\x00-\x1f] | "\\" ( ["\\/bfnrt] | "u" [0-9a-fA-F]{4} )
