# FlowIQ model reply: TypedQuery | Clarify | DraftRequest -- llama.cpp GBNF
# GENERATED by src/agent/typed-query-grammar.ts from the closed sets in
# src/agent/typed-query.ts, DATE_WINDOWS and the store. Do not edit by hand.
# Clarify and draft are replies the model may give; FlowIQ then answers on the
# deterministic path, as with the model off.

root ::= typed-query | clarify | draft

typed-query ::= "{\"kind\":\"query\",\"question\":" string ",\"intent\":" intent "}"

intent ::= "{\"domain\":" domain ",\"measure\":" measure ",\"aggregation\":" aggregation ",\"isWholePortfolioExplicit\":" bool ",\"isClassComparison\":" bool ",\"dateWindow\":" date-window ",\"dateExplicit\":" bool ",\"mentionedSources\":" sources ",\"paidOnly\":" bool ",\"decisionIds\":" decision-ids
  ( ",\"topK\":" topk )?
  ( ",\"buildingClass\":" building-class )?
  ( ",\"yearBuiltMin\":" year )?
  ( ",\"yearBuiltMax\":" year )?
  ( ",\"bedrooms\":" count )?
  ( ",\"bathrooms\":" half-num )?
  ( ",\"rentMin\":" rent )?
  ( ",\"rentMax\":" rent )?
  ( ",\"bedroomsMin\":" count )?
  ( ",\"bedroomsMax\":" count )?
  ( ",\"bathroomsMin\":" half-num )?
  ( ",\"bathroomsMax\":" half-num )?
  ( ",\"sqftMin\":" sqft )?
  ( ",\"sqftMax\":" sqft )?
  ( ",\"floorMin\":" floor )?
  ( ",\"floorMax\":" floor )?
  ( ",\"view\":" view )?
  ( ",\"unitStatus\":" unit-status | ",\"unitStatusIn\":" unit-status-pair )?
  ( ",\"leaseType\":" lease-type )?
  ( ",\"renewalStatus\":" renewal-status )?
  ( ",\"leaseStartWindow\":" date-window )?
  ( ",\"leaseEndWindow\":" date-window )?
  ( ",\"decisionAccepted\":" decision-accepted )?
  ( ",\"decisionDirection\":" decision-direction )?
  "}"

domain ::= "\"data_quality\"" | "\"decisions\"" | "\"marketing\"" | "\"leases\"" | "\"units\""
measure ::= "\"void_and_duplicate_counts\"" | "\"decision_lookup\"" | "\"decision_cohort_rejected\"" | "\"decision_post_spend_comparison\"" | "\"decision_outcome_learning\"" | "\"reallocation_leases\"" | "\"dead_spend_pairs\"" | "\"dead_spend_building\"" | "\"tour_to_lease_rate\"" | "\"apply_rate\"" | "\"applied_without_tour\"" | "\"applied_and_leased\"" | "\"cost_per_lead_and_tour\"" | "\"cost_per_lead\"" | "\"cost_per_tour\"" | "\"lead_count\"" | "\"spend_h1_vs_q3\"" | "\"spend_total\"" | "\"signed_leases_ranking\"" | "\"cost_per_signed_lease\"" | "\"ending_and_renewed\"" | "\"renewal_rate\"" | "\"renewal_rate_class_comparison\"" | "\"new_vs_renewal_and_concession\"" | "\"average_concession\"" | "\"total_concession\"" | "\"rent_at_risk\"" | "\"lease_count\"" | "\"vacancy_rate\"" | "\"occupied_share\"" | "\"avg_market_rent_and_sqft\"" | "\"avg_market_rent\"" | "\"avg_sqft\"" | "\"rent_per_sqft\"" | "\"unit_count\""
aggregation ::= "\"value\"" | "\"argmax\"" | "\"argmin\"" | "\"list\"" | "\"compare\""
unit-status ::= "\"notice\"" | "\"occupied\"" | "\"vacant\""
unit-status-pair ::= "[\"notice\",\"occupied\"]" | "[\"notice\",\"vacant\"]" | "[\"occupied\",\"vacant\"]"
lease-type ::= "\"new\"" | "\"renewal\""
renewal-status ::= "\"renewed\"" | "\"pending\"" | "\"notice_given\"" | "\"not_due\""
decision-accepted ::= "\"yes\"" | "\"no\"" | "\"all\""
decision-direction ::= "\"increase\"" | "\"decrease\""
building-class ::= "\"A\"" | "\"B\""
view ::= "\"city\"" | "\"courtyard\"" | "\"lake\"" | "\"none\""
sources ::= "[]" | "[" source ( "," source )* "]"
source ::= "\"Apartment List\"" | "\"Apartments.com\"" | "\"Facebook Ads\"" | "\"Google Ads\"" | "\"Referral\"" | "\"Rent.\"" | "\"Website\"" | "\"Zillow\""
decision-ids ::= "[]" | "[" decision-id ( "," decision-id )* "]"
decision-id ::= "\"X001\"" | "\"X002\"" | "\"X003\"" | "\"X004\"" | "\"X005\"" | "\"X006\"" | "\"X007\"" | "\"X008\"" | "\"X009\"" | "\"X010\""
date-window ::= "\"" ( "H1_2026" | "Q2_2026" | "Q3_2026" | "Q4_2026" | "APR_SEP_2026" | "Q1_2027" | mon "_20" [0-9] [0-9] | "YEAR_20" [0-9] [0-9] ) "\""
mon ::= "JAN" | "FEB" | "MAR" | "APR" | "MAY" | "JUN" | "JUL" | "AUG" | "SEP" | "OCT" | "NOV" | "DEC"

clarify ::= "{\"kind\":\"clarify\",\"options\":[" string "," string ( "," string )? ( "," string )? "]}"
draft ::= "{\"kind\":\"draft\",\"request\":" string "}"

bool ::= "true" | "false"
topk ::= "2" | "3" | "4" | "5" | "6" | "7" | "8" | "9" | "10"
count ::= [0-9]
half-num ::= [0-9] ( ".5" )?
year ::= ( "18" | "19" | "20" ) [0-9] [0-9]
sqft ::= "0" | [1-9] [0-9]{0,5}
floor ::= "0" | [1-9] [0-9]{0,2}
rent ::= "0" | [1-9] [0-9]{0,5}
string ::= "\"" char{1,300} "\""
char ::= [^"\\\x00-\x1f] | "\\" ( ["\\/bfnrt] | "u" [0-9a-fA-F]{4} )
